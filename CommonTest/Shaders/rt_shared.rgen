#version 460
#extension GL_EXT_ray_tracing : require
layout(set = 1, binding = 0, std140) uniform RTShared
{
    vec4 value;
}
sharedData;
layout(set = 1, binding = 1, std430) writeonly buffer RTOutput
{
    vec4 values[];
}
outputData;
void main()
{
    outputData.values[gl_LaunchIDEXT.x] = sharedData.value;
}
