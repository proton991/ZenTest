#version 450
layout(local_size_x = 1) in;
layout(set = 1, binding = 0) uniform texture2D inputTextures[16];
layout(set = 1, binding = 1) uniform sampler inputSamplers[16];
layout(set = 1, binding = 2, std430) buffer Output
{
    uint color;
}
outputData;
void main()
{
    outputData.color = packUnorm4x8(texture(sampler2D(inputTextures[0], inputSamplers[0]), vec2(0.5)));
}
